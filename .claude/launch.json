{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dr-backend",
      "runtimeExecutable": "dr",
      "runtimeArgs": [
        "visualize",
        "--no-auth",
        "--port",
        "8080",
        "--no-browser"
      ],
      "port": 8080
    },
    {
      "name": "viewer-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "design-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3005",
        "--directory",
        "design/node_pages"
      ],
      "port": 3005
    }
  ]
}
