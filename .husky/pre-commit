#!/bin/bash

# Pre-commit hook: Sync and validate API spec before commit
# This ensures the API spec is always in sync with upstream
#
# Supports offline mode: Set HUSKY_OFFLINE=1 environment variable to skip network operations

set -e

# Bypass corrupted global git config if present
# Prevents: "unable to access .gitconfig: Is a directory" errors
# See: https://github.com/tinkermonkey/documentation_robotics/issues/341
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_SYSTEM=/dev/null

echo "🔄 Checking API spec synchronization..."

# Check if running offline
if [ "$HUSKY_OFFLINE" = "1" ]; then
  echo "⚠️  Running in offline mode - skipping API spec sync"
  echo "✓ Commit allowed (offline mode enabled)"
  exit 0
fi

# Run the sync script (will fail if no network)
if ! npm run sync:api-spec; then
  echo "⚠️  Failed to sync API spec (network unreachable)"
  echo "   To proceed offline, run:"
  echo "     export HUSKY_OFFLINE=1"
  echo "     git commit -m \"message\""
  echo "   or in one line:"
  echo "     HUSKY_OFFLINE=1 git commit -m \"message\""
  exit 1
fi

# Check if the spec changed
# git diff --quiet exits 1 when a diff is detected, but also exits 128+ on a
# real error (corrupt index, permission denied) - distinguish the two instead
# of treating any non-zero exit as "spec was updated but not staged".
set +e
git diff --quiet docs/api-spec.yaml
diff_status=$?
set -e

if [ "$diff_status" -eq 0 ]; then
  echo "✓ API spec is already in sync"
elif [ "$diff_status" -eq 1 ]; then
  echo "📝 API spec was updated but not staged"
  echo "   To include these changes in your commit, run:"
  echo "     git add docs/api-spec.yaml"
else
  echo "❌ git diff failed while checking docs/api-spec.yaml (exit code $diff_status)"
  exit "$diff_status"
fi

exit 0
